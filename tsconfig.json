{
  "compilerOptions": {
    "target": "ES5",
    "lib": [
      "ESNext",
      "DOM"
    ],
    "module": "ESNext",
    "strict": true,
    "moduleResolution": "Node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "sourceMap": false,
    "types": ["jest", "node"],
    "declaration": false,
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules"
  ]
}
