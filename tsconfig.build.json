{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["node"],
    "lib": ["ESNext"],
    "declaration": true,
    "declarationDir": "dist/types",
    "declarationMap": false,
    "outDir": "dist",
    "rootDir": "src",
    "target": "ES2019",
    "module": "ESNext",
    "moduleResolution": "Node",
    "sourceMap": false,
    "noEmit": false,
    "verbatimModuleSyntax": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "__tests__"]
}
