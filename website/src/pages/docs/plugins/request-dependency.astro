import DocsLayout from '../../../layouts/DocsLayout.astro';
import CodeBlock from '../../../components/CodeBlock.astro';
const _shikiCode0 = "import { createRequestDependencyPlugin } from 'axios-retryer/plugins/RequestDependencyPlugin';";
const _shikiCode1 = "import { createRetryer, AXIOS_RETRYER_REQUEST_PRIORITIES } from 'axios-retryer';\nimport { createRequestDependencyPlugin } from 'axios-retryer/plugins/RequestDependencyPlugin';\n\nconst retryer = createRetryer({ maxConcurrentRequests: 4 });\n\nretryer.use(\n  createRequestDependencyPlugin({\n    blockingPriorityThreshold: AXIOS_RETRYER_REQUEST_PRIORITIES.HIGH,\n    // Any request with priority \u2265 HIGH is \"blocking\"\n    // Lower-priority requests wait until all blocking requests complete\n    cancelPendingOnDependencyFailure: true,\n    // Cancel queued lower-priority work if a blocker fails\n  })\n);";
const _shikiCode2 = "{\n  blockingPriorityThreshold: AXIOS_RETRYER_REQUEST_PRIORITIES.CRITICAL,\n  // Priority level at which a request becomes \"blocking\" (default: CRITICAL)\n\n  cancelPendingOnDependencyFailure: false,\n  // When true: cancel queued non-blocking requests if any blocker fails (default: false)\n}";
const _shikiCode3 = "import { AXIOS_RETRYER_REQUEST_PRIORITIES } from 'axios-retryer';\n\n// This blocks all lower-priority requests in the queue\nawait retryer.axiosInstance.post('/auth/login', creds, {\n  __axiosRetryer: { priority: AXIOS_RETRYER_REQUEST_PRIORITIES.CRITICAL },\n});\n\n// These are held until the CRITICAL request above completes\nretryer.axiosInstance.get('/api/recommendations', {\n  __axiosRetryer: { priority: AXIOS_RETRYER_REQUEST_PRIORITIES.LOW },\n});\nretryer.axiosInstance.get('/api/analytics', {\n  __axiosRetryer: { priority: AXIOS_RETRYER_REQUEST_PRIORITIES.LOW },\n});";
const _shikiCode4 = "const dep = createRequestDependencyPlugin({\n  blockingPriorityThreshold: AXIOS_RETRYER_REQUEST_PRIORITIES.CRITICAL,\n});\nretryer.use(dep);\n\n// Check if a given config is a blocking request\nconst isBlocking = dep.isBlockingRequest(config);\n\n// How many blocking requests are currently in flight\nconst count = dep.getActiveBlockingRequestCount();";
const _shikiCode5 = "const managed = retryer.use(createRequestDependencyPlugin({\n  blockingPriorityThreshold: AXIOS_RETRYER_REQUEST_PRIORITIES.CRITICAL,\n}));\n\nmanaged.on('onBlockingRequestFailed', (config) => {\n  console.error('Critical request failed:', config.url);\n  // Possibly redirect to error page or retry\n});\n\nmanaged.on('onAllBlockingRequestsResolved', () => {\n  console.log('All critical requests done \u2014 releasing queue');\n});";
const _shikiCode6 = "// Ensure payment goes first; analytics doesn't race it\nasync function checkout(cartId: string) {\n  // CRITICAL: Payment must complete before anything else\n  const { data: order } = await retryer.axiosInstance.post(\n    '/api/checkout',\n    { cartId },\n    { __axiosRetryer: { priority: AXIOS_RETRYER_REQUEST_PRIORITIES.CRITICAL } }\n  );\n\n  // LOW: Analytics can wait\n  retryer.axiosInstance.post(\n    '/api/analytics/checkout',\n    { orderId: order.id },\n    { __axiosRetryer: { priority: AXIOS_RETRYER_REQUEST_PRIORITIES.LOW } }\n  );\n\n  return order;\n}";
