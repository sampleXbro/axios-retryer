<DocsLayout title="Events" description="Subscribe to lifecycle events in axios-retryer for monitoring, logging, and custom workflows.">

<h1 class="page-title">Events</h1>
<p class="page-lead">The event system lets you react to every stage of the retry lifecycle. Use it for logging, dashboards, analytics, and custom side effects — without touching request code.</p>

<h2>Subscribing to events</h2>
<pre><code class="language-typescript">import &#123; createRetryer &#125; from 'axios-retryer';
import &#123; createMetricsPlugin &#125; from 'axios-retryer/plugins/MetricsPlugin';

const retryer = createRetryer();
retryer.use(createMetricsPlugin());

// Chain multiple subscriptions
retryer
  .on('onRetryProcessStarted', () =&gt; &#123;
    console.log('Retry process started');
  &#125;)
  .on('beforeRetry', (config) =&gt; &#123;
    console.log(`About to retry: $&#123;'$&#123;config.method?.toUpperCase()} $&#123;config.url}'}`);
  &#125;)
  .on('afterRetry', (config, success) =&gt; &#123;
    console.log(`Retry attempt $&#123;success ? 'succeeded' : 'failed'}`);
  &#125;)
  .on('onRetryProcessFinished', () =&gt; &#123;
    console.log('All retry attempts complete');
  &#125;)
  .on('onFailure', (error) =&gt; &#123;
    analytics.track('api_failure', &#123; url: error.config?.url &#125;);
  &#125;)
  .on('onMetricsUpdated', (metrics) =&gt; &#123;
    // Requires MetricsPlugin
    updateDashboard(metrics);
  &#125;);</code></pre>

<h2>Unsubscribing</h2>
<pre><code class="language-typescript">const handler = (config: any) =&gt; console.log(config.url);
retryer.on('beforeRetry', handler);

// Later, when cleanup is needed:
retryer.off('beforeRetry', handler);</code></pre>

<h2>Plugin-specific events</h2>
<p>Plugin events become available after calling <code>use()</code>. The returned value has the widened event type:</p>

<pre><code class="language-typescript">import &#123; createTokenRefreshPlugin &#125; from 'axios-retryer/plugins/TokenRefreshPlugin';

// The return value of use() has the plugin's events typed
const retryerWithAuth = retryer.use(
  createTokenRefreshPlugin(async (axios) =&gt; &#123;
    const &#123; data &#125; = await axios.post('/auth/refresh');
    return &#123; token: data.accessToken &#125;;
  &#125;)
);

retryerWithAuth.on('onTokenRefreshed', (token) =&gt; &#123;
  console.log('Token refreshed:', token);
&#125;);</code></pre>

<h2>Event reference</h2>
<table>
  <thead><tr><th>Event</th><th>Payload</th><th>Plugin required</th><th>Description</th></tr></thead>
  <tbody>
    <tr><td><code>onRetryProcessStarted</code></td><td>—</td><td>—</td><td>Retry cycle begins for a request</td></tr>
    <tr><td><code>beforeRetry</code></td><td><code>AxiosRequestConfig</code></td><td>—</td><td>Before each individual retry attempt</td></tr>
    <tr><td><code>afterRetry</code></td><td><code>config, success: boolean</code></td><td>—</td><td>After each individual retry attempt</td></tr>
    <tr><td><code>onFailure</code></td><td><code>AxiosError</code></td><td>—</td><td>A single attempt failed</td></tr>
    <tr><td><code>onRetryProcessFinished</code></td><td>—</td><td>—</td><td>All retry attempts complete (success or terminal failure)</td></tr>
    <tr><td><code>onRequestCancelled</code></td><td><code>requestId: string</code></td><td>—</td><td>A request was cancelled</td></tr>
    <tr><td><code>onInternetConnectionError</code></td><td><code>AxiosError</code></td><td>—</td><td>Network-level error (no response)</td></tr>
    <tr><td><code>onMetricsUpdated</code></td><td><code>RetryMetrics</code></td><td>MetricsPlugin</td><td>Metrics snapshot after each request cycle</td></tr>
    <tr><td><code>onTokenRefreshed</code></td><td><code>token: string</code></td><td>TokenRefreshPlugin</td><td>Token refreshed successfully</td></tr>
    <tr><td><code>onBlockingRequestFailed</code></td><td><code>config</code></td><td>RequestDependencyPlugin</td><td>A CRITICAL/blocking request failed</td></tr>
    <tr><td><code>onAllBlockingRequestsResolved</code></td><td>—</td><td>RequestDependencyPlugin</td><td>All blocking requests completed</td></tr>
    <tr><td><code>onManualRetryProcessStarted</code></td><td>—</td><td>ManualRetryPlugin</td><td>Manual replay begins</td></tr>
  </tbody>
</table>

<h2>Real-time metrics dashboard pattern</h2>
<pre><code class="language-typescript">import &#123; createMetricsPlugin &#125; from 'axios-retryer/plugins/MetricsPlugin';

retryer.use(createMetricsPlugin());

retryer.on('onMetricsUpdated', (metrics) =&gt; &#123;
  // metrics shape:
  // &#123;
  //   totalRequests: number,
  //   successfulRetries: number,
  //   failedRetries: number,
  //   completelyFailedRequests: number,
  //   totalRetryAttempts: number,
  //   averageRetryDelay: number,
  //   timerHealth: &#123; activeTimers, activeRetryTimers, healthScore &#125;
  // &#125;

  myDashboard.update(&#123;
    successRate: metrics.successfulRetries / (metrics.totalRequests || 1),
    failureRate: metrics.completelyFailedRequests,
    avgDelay: metrics.averageRetryDelay,
  &#125;);
&#125;);</code></pre>

