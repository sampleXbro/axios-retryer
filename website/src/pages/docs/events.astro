import CodeBlock from '../../components/CodeBlock.astro';
const _shikiCode0 = "import { createRetryer } from 'axios-retryer';\nimport { createMetricsPlugin } from 'axios-retryer/plugins/MetricsPlugin';\n\nconst retryer = createRetryer();\nretryer.use(createMetricsPlugin());\n\n// Chain multiple subscriptions\nretryer\n  .on('onRetryProcessStarted', () => {\n    console.log('Retry process started');\n  })\n  .on('beforeRetry', (config) => {\n    console.log(`About to retry: ${'${config.method?.toUpperCase()} ${config.url}'}`);\n  })\n  .on('afterRetry', (config, success) => {\n    console.log(`Retry attempt ${success ? 'succeeded' : 'failed'}`);\n  })\n  .on('onRetryProcessFinished', () => {\n    console.log('All retry attempts complete');\n  })\n  .on('onFailure', (error) => {\n    analytics.track('api_failure', { url: error.config?.url });\n  })\n  .on('onMetricsUpdated', (metrics) => {\n    // Requires MetricsPlugin\n    updateDashboard(metrics);\n  });";
const _shikiCode1 = "const handler = (config: any) => console.log(config.url);\nretryer.on('beforeRetry', handler);\n\n// Later, when cleanup is needed:\nretryer.off('beforeRetry', handler);";
const _shikiCode2 = "import { createTokenRefreshPlugin } from 'axios-retryer/plugins/TokenRefreshPlugin';\n\n// The return value of use() has the plugin's events typed\nconst retryerWithAuth = retryer.use(\n  createTokenRefreshPlugin(async (axios) => {\n    const { data } = await axios.post('/auth/refresh');\n    return { token: data.accessToken };\n  })\n);\n\nretryerWithAuth.on('onTokenRefreshed', (token) => {\n  console.log('Token refreshed:', token);\n});";
const _shikiCode3 = "import { createMetricsPlugin } from 'axios-retryer/plugins/MetricsPlugin';\n\nretryer.use(createMetricsPlugin());\n\nretryer.on('onMetricsUpdated', (metrics) => {\n  // metrics shape:\n  // {\n  //   totalRequests: number,\n  //   successfulRetries: number,\n  //   failedRetries: number,\n  //   completelyFailedRequests: number,\n  //   totalRetryAttempts: number,\n  //   averageRetryDelay: number,\n  //   timerHealth: { activeTimers, activeRetryTimers, healthScore }\n  // }\n\n  myDashboard.update({\n    successRate: metrics.successfulRetries / (metrics.totalRequests || 1),\n    failureRate: metrics.completelyFailedRequests,\n    avgDelay: metrics.averageRetryDelay,\n  });\n});";
